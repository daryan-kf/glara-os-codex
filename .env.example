# Convex CLI writes these after `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Private signing/email configuration belongs in Convex deployment environment,
# never in NEXT_PUBLIC_* variables. See README.
