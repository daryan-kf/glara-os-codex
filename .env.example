# Convex CLI writes these after `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Private signing/email configuration belongs in Convex deployment environment,
# never in NEXT_PUBLIC_* variables. See README.

# M8 AI provider: configure these privately in the Convex deployment environment.
# Never prefix secrets with NEXT_PUBLIC_ or commit actual values.
# OPENAI_API_KEY=configure-in-convex-only
# GLARA_AI_MODEL=approved-model-name
# GLARA_AI_SECURITY_APPROVED=false
# Keep disabled until provider/data handling, retention and security review are approved.

# M9: these private values belong in the Convex development environment only.
# External sending and calendar sync default to disabled.
# M9_EMAIL_ENABLED=false
# M9_EMAIL_VERIFIED=false
# M9_RESEND_KEY=configure-in-convex-only
# M9_RESEND_WEBHOOK_SECRET=configure-in-convex-only
# M9_RESEND_WEBHOOK_SECRET_PREVIOUS=optional-rotation-secret
# M9_UNSUBSCRIBE_SECRET=configure-in-convex-only
# M9_EMAIL_FROM=Support@glarahome.com
# M9_EMAIL_REPLY_TO=Support@glarahome.com
# M9_EMAIL_TEST_ALLOWLIST=explicitly-authorized-non-customer-inbox
# M9_PUBLIC_HTTP_ORIGIN=https://your-development-deployment.convex.site
# M9_CALENDAR_ENABLED=false
# M9_GOOGLE_CALENDAR_ID=dedicated-development-calendar
# M9_GOOGLE_CLIENT_ID=configure-in-convex-only
# M9_GOOGLE_CLIENT_SECRET=configure-in-convex-only
# M9_GOOGLE_REFRESH_TOKEN=configure-in-convex-only

# M10A preparation: explicit server-side environment designation; never browser input.
# Set independently in each future approved frontend/backend environment.
# GLARA_ENVIRONMENT=development
# HSTS is opt-in only after HTTPS and the production hostname are verified.
# GLARA_HTTPS_READY=false

# Convex server-only emergency override; true forces all protected capabilities frozen.
# Set true before any isolated restore; never expose as NEXT_PUBLIC configuration.
# GLARA_RECOVERY_MODE=false

# M10A does NOT authorize production enablement. All approvals default false.
# GLARA_PRODUCTION_APPROVED=false
# GLARA_PRODUCTION_EMAIL_APPROVED=false
# GLARA_PRODUCTION_CALENDAR_APPROVED=false
# GLARA_PRODUCTION_AI_APPROVED=false
# GLARA_PRODUCTION_AUTOMATION_APPROVED=false
# GLARA_PRODUCTION_AUTH_EMAIL_APPROVED=false
# GLARA_PRODUCTION_ONBOARDING_APPROVED=false
# AUTH_EMAIL_ENABLED=false
# Explicit environment designation is required in the offline preflight.
