# Public frontend configuration for hosted development builds (Vercel).
# NEXT_PUBLIC_* values are compiled into the browser bundle and are not secrets.
# This keeps GLARA_ENVIRONMENT=development so every production capability gate
# stays closed; see src/lib/security/preflight.ts.
NEXT_PUBLIC_CONVEX_URL=https://woozy-jaguar-392.eu-west-1.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://woozy-jaguar-392.eu-west-1.convex.site
GLARA_ENVIRONMENT=development
